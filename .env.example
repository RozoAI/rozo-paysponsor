# Copy to .env and fill in. NEVER commit .env — it is gitignored.
# Every script reads secrets from the environment only; nothing is ever
# printed or passed as a CLI argument.

# --- deposit side (payer) ---
# Private key of a funded Base wallet: needs the USDC you want to send
# plus a little ETH for gas (~$0.01 per run).
DEPOSIT_EVM_PRIVATE_KEY=0xYOUR_BASE_PRIVATE_KEY

# --- claim side (recipient) ---
# Usually NOT needed: scripts/create-wallet.mjs stellar generates a fresh
# recipient and claim-intents.mjs reads it from wallets/ automatically.
# Set this only to claim with a specific existing wallet.
# STELLAR_SECRET=SYOUR_STELLAR_SECRET

# --- optional overrides (defaults shown) ---
# INTENTS_API=https://intentapiv4.rozo.ai/functions/v1/payment-api
# BASE_RPC_URL=https://mainnet.base.org
# HORIZON_URL=https://horizon.stellar.org
# APP_ID=rozoTest
