# Copy to .env and fill in. NEVER commit .env — it is gitignored.
# Every script reads secrets from this environment, or (for the Stellar
# recipient key only) from the 0600 wallets/*.txt file that
# scripts/create-wallet.mjs writes locally. Both paths are gitignored, and a
# secret is never printed and never passed as a CLI argument.

# --- deposit side (payer) ---
# Private key of a Base wallet you control. Fund it before the first run:
#
#   USDC on Base : at least the amount you want to send, e.g. 1 USDC
#   ETH  on Base : ~0.0002 ETH covers a few hundred runs
#                  (one deposit costs well under a cent of gas)
#
# What a 1 USDC run actually delivers, at XLM ≈ $0.17:
#
#   1.00  you send
#  -0.01  bridge fee
#   ----
#   0.99  parked as a claimable balance
#  -0.40  claim fee (2 XLM reserve deposit + $0.05, ceiled to the cent)
#   ----
#   0.59  lands in the brand-new Stellar wallet, which paid zero gas
#  +0.16  refunded later if you close the account (95% of the unlocked
#         reserve, paid back in USDC)
#   ----
#   0.75  total recovered from a 1 USDC run
#
# Send a larger amount and only the claim fee stays flat — it is a fixed
# reserve deposit, not a percentage. The exact numbers are quoted to you
# before anything is spent (deposit-intents.mjs prints the quote first).
#
# If the destination wallet ALREADY has a USDC trustline there is no claim
# fee at all: the payout is delivered directly.
DEPOSIT_EVM_PRIVATE_KEY=0xYOUR_BASE_PRIVATE_KEY

# --- claim side (recipient) ---
# Usually NOT needed: scripts/create-wallet.mjs stellar generates a fresh
# recipient and claim-intents.mjs reads it from wallets/ automatically.
# Set this only to claim with a specific existing wallet.
# STELLAR_SECRET=SYOUR_STELLAR_SECRET

# --- application identity (optional) ---
# Leave BOTH of these unset to run the scripts as-is: they fall back to the
# public test id `rozoTest`, which needs no signup and no API key. Sponsored
# payouts under it are limited to $0.01 - $100 net per payout, and runs made
# with it are excluded from our production statistics.
#
# For a higher limit, or for anything you intend to ship, register your own
# application at https://partners.rozo.ai (application type: wallet). You get an
# appId AND an API key — they are used as a PAIR. A registered appId (they start
# with `wallet_` or `merchant`) is rejected with 400 `missing_api_key` if the
# key is missing, so set both or neither — the scripts refuse to start on either
# half-configured combination (key without a registered appId included, since
# that would send your secret under the public test identity).
# APP_ID=wallet_your_app_id
# ROZO_API_KEY=your_api_key

# --- optional endpoint overrides (defaults shown) ---
# INTENTS_API=https://intentapiv4.rozo.ai/functions/v1/payment-api
# BASE_RPC_URL=https://mainnet.base.org
# HORIZON_URL=https://horizon.stellar.org
